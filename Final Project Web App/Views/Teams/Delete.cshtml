@model Teams
@{
    ViewData["Title"] = "Delete team";
}

<h1>Delete team</h1>

<p class="text-danger">Are you sure you want to delete this team?</p>

<dl class="row">
    <dt class="col-sm-2">Team</dt>
    <dd class="col-sm-10">@Model.TeamName</dd>

    <dt class="col-sm-2">Conference</dt>
    <dd class="col-sm-10">@Model.Conference?.ConferenceName</dd>

    <dt class="col-sm-2">Division</dt>
    <dd class="col-sm-10">@Model.Division?.divisionName</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete team</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
