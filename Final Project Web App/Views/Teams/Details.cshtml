@model Teams
@{
    ViewData["Title"] = "Team details";
}

<h1>@Model.TeamName</h1>

<dl class="row">
    <dt class="col-sm-2">Conference</dt>
    <dd class="col-sm-10">@Model.Conference?.ConferenceName</dd>

    <dt class="col-sm-2">Division</dt>
    <dd class="col-sm-10">@Model.Division?.divisionName</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-outline-secondary">Back to teams</a>
